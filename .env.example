# ─────────────────────────────────────────────────────────────────────────────
# Zero Runtime connection
# ─────────────────────────────────────────────────────────────────────────────
# The only value every example needs.
ZERORUNTIME_AUTH_TOKEN=

# Optional overrides. The SDK already defaults to us2.zeroruntime.ai over TLS;
# set these only to point somewhere else (a local runtime, another region).
# ZERORUNTIME_TARGET=us2.zeroruntime.ai
# ZERORUNTIME_INSECURE=0

# ─────────────────────────────────────────────────────────────────────────────
# Provider keys (alphabetical) — set only the ones your chosen example uses.
